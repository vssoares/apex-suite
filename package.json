{
  "name": "apex-suite",
  "version": "0.1.0",
  "description": "Apex Suite — desktop gaming utility (layout)",
  "main": "dist-electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4444",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:electron": "tsc -p electron/tsconfig.json",
    "electron:dev": "npm run build:electron && concurrently \"ng serve --port 4444\" \"wait-on http://localhost:4444 && electron .\"",
    "electron:build": "ng build --configuration production && npm run build:electron && electron-builder"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "build": {
    "appId": "com.apexsuite.app",
    "productName": "Apex Suite",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/apex-suite/browser/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@ng-icons/core": "^36.1.0",
    "@ng-icons/material-icons": "^36.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.0",
    "@types/node": "^26.6.2",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "wait-on": "^9.1.0"
  }
}
