{
  "name": "apex-suite",
  "version": "0.1.3",
  "description": "Apex Color + — calibração de display",
  "author": "vssoares",
  "private": true,
  "packageManager": "npm@10.9.8",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4444",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "icons": "node scripts/generate-icons.mjs",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:app": "ng build --configuration production && npm run build:electron",
    "electron:dev": "npm run build:electron && concurrently -k \"ng serve --port 4444\" \"wait-on http://localhost:4444 && electron . --user-data-dir=.electron-dev-data\"",
    "electron:quit-dev": "electron . --user-data-dir=.electron-dev-data --apex-quit",
    "electron:build": "npm run dist:win",
    "dist": "npm run build:app && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "dist:win": "npm run build:app && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "dist:win:publish": "npm run build:app && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.apexsuite.app",
    "productName": "Apex Color +",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/koffi/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "artifactName": "ApexColorPlus-Setup-${version}.${ext}",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "vssoares",
      "repo": "apex-suite",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@ng-icons/core": "^36.1.0",
    "@ng-icons/material-icons": "^36.1.0",
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.1",
    "rxjs": "~7.8.0",
    "systeminformation": "^5.33.13",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.28",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "wait-on": "^9.1.0"
  }
}
